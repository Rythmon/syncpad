{
  "name": "syncpad",
  "version": "1.0.0",
  "private": true,
  "description": "SyncPad — Distributed, Conflict-Free Real-Time Collaborative Text Editor with Yjs CRDTs, Redis Pub/Sub, and Offline-First IndexedDB Sync",
  "scripts": {
    "dev": "concurrently -n \"next,ws-server\" -c \"cyan,magenta\" \"pnpm dev:next\" \"pnpm dev:server\"",
    "dev:next": "next dev -p 3000",
    "dev:server": "tsx watch server/index.ts",
    "build": "next build && tsc -p tsconfig.server.json",
    "build:next": "next build",
    "start": "concurrently -n \"next,ws-server\" -c \"cyan,magenta\" \"next start -p 3000\" \"tsx server/index.ts\"",
    "lint": "next lint"
  },
  "dependencies": {
    "@tiptap/extension-character-count": "^2.10.4",
    "@tiptap/extension-collaboration": "^2.10.4",
    "@tiptap/extension-collaboration-cursor": "^2.10.4",
    "@tiptap/extension-placeholder": "^2.10.4",
    "@tiptap/pm": "^2.10.4",
    "@tiptap/react": "^2.10.4",
    "@tiptap/starter-kit": "^2.10.4",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "lib0": "^0.2.119",
    "lucide-react": "^0.453.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "ws": "^8.18.0",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.6",
    "y-websocket": "^2.0.4",
    "yjs": "^13.6.20"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.12",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
